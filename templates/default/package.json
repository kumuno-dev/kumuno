{
  "name": "kumuno",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node --env-file-if-exists=.env.test.local node_modules/vitest/vitest.mjs run --config vitest.database.config.mts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/database.ts check",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/database.ts migrate",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "db:migration:create": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev --create-only",
    "postinstall": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test:auth": "tsx --env-file-if-exists=.env.test.local scripts/test-auth.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
