# Copy to .env.local and replace the placeholder with your own password.
# Percent-encode special characters in URL usernames/passwords.
DATABASE_URL=postgresql://kumuno:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/kumuno

# For npm run test:db, set this in a separate .env.test.local file.
# Use a dedicated DB whose name ends with _test; never point it at production.
# TEST_DATABASE_URL=postgresql://kumuno:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/kumuno_test

# Migration作成専用。データが再構築されるため、他のDBと共用しない
SHADOW_DATABASE_URL="postgresql://kumuno:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/kumuno_shadow"

# 開発Seed時だけ有効化し、実行後は削除する。productionでは実行不可。
# SEED_ALLOW_DEVELOPMENT=true
# SEED_ADMIN_PASSWORD=（自分で決めた12〜128文字。固定値をcommitしない）

# 認証用。32バイト以上の乱数を生成し、出力を秘密鍵として設定する。
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000
# プロキシが上書きする単一IPヘッダー名。未設定時は全利用者で試行制限を共有。
# AUTH_TRUSTED_IP_HEADER=x-real-ip
