generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]
  auditLogs   AuditLog[]
  equipment   Equipment[]
  medicalDevices MedicalDevice[]
  medicalLoans MedicalLoan[]
  medicalInspections MedicalInspection[]
  medicalRepairs MedicalRepair[]
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  parentId       String?      @db.Uuid
  code           String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent         Department?  @relation("DepartmentTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  children       Department[] @relation("DepartmentTree")
  users          User[]
  equipment      Equipment[]
  medicalDevices MedicalDevice[]
  medicalLoans MedicalLoan[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([parentId, organizationId])
}

enum Role {
  ADMIN
  MANAGER
  USER
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  departmentId   String?      @db.Uuid
  role           Role         @default(USER)
  employeeCode   String?
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false)
  image          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  accounts       Account[]
  sessions       Session[]
  assignedEquipment Equipment[]
  issuedMedicalLoans MedicalLoan[] @relation("MedicalLoanIssuer")
  returnedMedicalLoans MedicalLoan[] @relation("MedicalLoanReturner")
  medicalInspections MedicalInspection[]
  medicalRepairs MedicalRepair[]

  @@unique([id, organizationId])

  @@unique([organizationId, employeeCode])
  @@index([departmentId, organizationId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  count Int
  lastRequest BigInt
}


enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  action         AuditAction
  resourceType   String
  resourceId     String       @db.Uuid
  timestamp      DateTime     @default(now()) @db.Timestamptz(3)
  metadata       Json
  before         Json?
  after          Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, timestamp, id])
  @@index([organizationId, resourceType, resourceId])
}


enum EquipmentStatus {
  IN_USE
  STORAGE
  REPAIR
  DISPOSED
}

model Equipment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  category       String
  purchaseDate   DateTime?       @db.Date
  purchasePrice  Decimal?        @db.Decimal(14, 2)
  departmentId   String?         @db.Uuid
  assignedUserId String?         @db.Uuid
  status         EquipmentStatus @default(STORAGE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     Department?     @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  assignedUser   User?           @relation(fields: [assignedUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, name, id])
  @@index([departmentId, organizationId])
  @@index([assignedUserId, organizationId])
}

// Ledger lifecycle only; lending availability belongs to a later workflow.
enum MedicalDeviceStatus {
  IN_SERVICE
  SUSPENDED
  RETIRED
}

model MedicalDevice {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  managementNumber String
  assetNumber String?
  name String
  category String
  manufacturer String?
  modelName String?
  serialNumber String?
  departmentId String? @db.Uuid
  location String?
  purchaseDate DateTime? @db.Date
  warrantyUntil DateTime? @db.Date
  returnInspectionPending Boolean @default(false)
  status MedicalDeviceStatus @default(IN_SERVICE)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  loans MedicalLoan[]
  inspections MedicalInspection[]
  repairs MedicalRepair[]

  @@unique([id, organizationId])
  @@unique([organizationId, managementNumber])
  @@index([organizationId, name, id])
  @@index([departmentId, organizationId])
}

model MedicalLoan {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  deviceId String @db.Uuid
  departmentId String @db.Uuid
  destinationName String
  destinationLocation String?
  loanedAt DateTime @default(now()) @db.Timestamptz(3)
  loanedById String @db.Uuid
  returnedAt DateTime? @db.Timestamptz(3)
  returnedById String? @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device MedicalDevice @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  department Department @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  loanedBy User @relation("MedicalLoanIssuer", fields: [loanedById, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  returnedBy User? @relation("MedicalLoanReturner", fields: [returnedById, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  inspections MedicalInspection[]

  @@unique([id, organizationId])
  @@index([organizationId, returnedAt, loanedAt, id])
  @@index([deviceId, organizationId])
  @@index([departmentId, organizationId])
  @@index([loanedById, organizationId])
  @@index([returnedById, organizationId])
}

enum MedicalInspectionResult {
  PASSED
  FAILED
  INCOMPLETE
}

enum MedicalInspectionKind {
  POST_RETURN
  PERIODIC
  OTHER
}

model MedicalInspection {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  deviceId String @db.Uuid
  inspectedById String @db.Uuid
  returnLoanId String? @db.Uuid
  inspectionDate DateTime @db.Date
  kind MedicalInspectionKind
  result MedicalInspectionResult
  content String
  nextInspectionDate DateTime? @db.Date
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  clearedPending Boolean @default(false)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device MedicalDevice @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  returnLoan MedicalLoan? @relation(fields: [returnLoanId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  inspectedBy User @relation(fields: [inspectedById, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, inspectionDate, id])
  @@index([deviceId, organizationId])
  @@index([inspectedById, organizationId])
  @@index([returnLoanId, organizationId])
}


enum MedicalRepairStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
}

model MedicalRepair {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  deviceId String @db.Uuid
  reportedById String @db.Uuid
  status MedicalRepairStatus @default(REQUESTED)
  problem String
  completionContent String?
  reportedAt DateTime @default(now()) @db.Timestamptz(3)
  startedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device MedicalDevice @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  reportedBy User @relation(fields: [reportedById, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, reportedAt, id])
  @@index([deviceId, organizationId])
  @@index([reportedById, organizationId])
}
