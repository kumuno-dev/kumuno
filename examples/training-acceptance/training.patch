@@ -0,0 +1,17 @@
+import { InputError, field, identifier } from "../management/validation";
+import type { TrainingStatus } from "../generated/prisma/enums";
+export const statuses = { IN_PROGRESS: "受講中", COMPLETED: "修了" };
+function date(value: string, label: string): Date {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value) || !Number.isFinite(Date.parse(value)) || new Date(value).toISOString().slice(0,10) !== value || value < "0001-01-01") throw new InputError(`${label}を確認してください。`);
+  return new Date(value);
+}
+export function parseTraining(form: FormData) {
+  const id = field(form, "id", 36, false);
+  const attendedOn = date(field(form, "attendedOn", 10), "受講日");
+  const expiry = field(form, "expiresOn", 10, false);
+  const expiresOn = expiry ? date(expiry, "有効期限") : null;
+  if (expiresOn && expiresOn < attendedOn) throw new InputError("有効期限は受講日以降にしてください。");
+  const status = field(form, "status");
+  if (!Object.hasOwn(statuses, status)) throw new InputError("修了状況を確認してください。");
+  return { id: id ? identifier(id) : undefined, userId: identifier(field(form, "userId", 36)), name: field(form, "name"), attendedOn, expiresOn, status: status as TrainingStatus, notes: field(form, "notes", 2000, false) || null };
+}
