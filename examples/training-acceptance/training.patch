new file mode 100644
index 0000000..bd79886
--- /dev/null
+++ b/src/training/service.ts
@@ -0,0 +1,29 @@
+import type { PrismaClient } from "../generated/prisma/client";
+import { appendAuditLog } from "../audit/log";
+import { requireTransactionActor } from "../authorization/transaction-actor";
+import { InputError, identifier } from "../management/validation";
+import { parseTraining } from "./validation";
+export async function saveTraining(db: PrismaClient, actorId: string, organizationId: string, form: FormData) {
+  const { id, ...data } = parseTraining(form);
+  return db.$transaction(async tx => {
+    const actor = await requireTransactionActor(tx, actorId, "training:manage", organizationId);
+    const before = id ? await tx.training.findFirst({ where: { id, organizationId } }) : null;
+    if (id && !before) throw new InputError("研修が見つかりません。");
+    const user = await tx.user.findFirst({ where: { id: data.userId, organizationId } });
+    // Historical records remain editable after an employee leaves; new assignments require an active user.
+    if (!user || (!user.isActive && before?.userId !== user.id)) throw new InputError("有効な受講者を選択してください。");
+    const after = before ? await tx.training.update({ where: { id }, data }) : await tx.training.create({ data: { ...data, organizationId } });
+    await appendAuditLog(tx, actor, { action: before ? "UPDATE" : "CREATE", resourceType: "Training", resourceId: after.id, before: before ?? undefined, after });
+    return after.id;
+  }, { isolationLevel: "Serializable" });
+}
+export async function deleteTraining(db: PrismaClient, actorId: string, organizationId: string, id: string) {
+  identifier(id);
+  return db.$transaction(async tx => {
+    const actor = await requireTransactionActor(tx, actorId, "training:manage", organizationId);
+    const before = await tx.training.findFirst({ where: { id, organizationId } });
+    if (!before) throw new InputError("研修が見つかりません。");
+    await tx.training.delete({ where: { id } });
+    await appendAuditLog(tx, actor, { action: "DELETE", resourceType: "Training", resourceId: id, before });
+  }, { isolationLevel: "Serializable" });
+}
