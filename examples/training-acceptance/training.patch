+++ b/prisma/migrations/20261001023238_add_training/migration.sql
@@ -0,0 +1,36 @@
+BEGIN;
+
+-- CreateEnum
+CREATE TYPE "TrainingStatus" AS ENUM ('IN_PROGRESS', 'COMPLETED');
+
+-- CreateTable
+CREATE TABLE "Training" (
+    "id" UUID NOT NULL,
+    "organizationId" UUID NOT NULL,
+    "userId" UUID NOT NULL,
+    "name" TEXT NOT NULL,
+    "attendedOn" DATE NOT NULL,
+    "expiresOn" DATE,
+    "status" "TrainingStatus" NOT NULL DEFAULT 'IN_PROGRESS',
+    "notes" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "Training_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "Training_organizationId_attendedOn_id_idx" ON "Training"("organizationId", "attendedOn", "id");
+
+-- CreateIndex
+CREATE INDEX "Training_userId_organizationId_idx" ON "Training"("userId", "organizationId");
+
+-- AddForeignKey
+ALTER TABLE "Training" ADD CONSTRAINT "Training_organizationId_fkey" FOREIGN KEY ("organizationId") REFERENCES "Organization"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "Training" ADD CONSTRAINT "Training_userId_organizationId_fkey" FOREIGN KEY ("userId", "organizationId") REFERENCES "User"("id", "organizationId") ON DELETE RESTRICT ON UPDATE RESTRICT;
+
+ALTER TABLE "Training" ADD CONSTRAINT "Training_expiry_after_attendance" CHECK ("expiresOn" IS NULL OR "expiresOn" >= "attendedOn");
+
+COMMIT;
